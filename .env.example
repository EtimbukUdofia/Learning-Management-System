# =============================================
# LMS BACKEND - ENVIRONMENT CONFIGURATION
# TS Academy Capstone - Group 1
# Copy this file to .env and fill in actual values
# =============================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
# Local: mongodb://localhost:27017/lms_db
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/lms_db
MONGO_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/?appName=lms
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/?appName=lms

# JWT (Generate secure keys: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Email (NodeMailer / SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=LMS Academy <noreply@lmsacademy.com>

# Cloudinary (Media Storage)
# Get credentials at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paystack (Payments) - REPLACES STRIPE
# Get credentials at: https://paystack.com/settings/api-keys
# Use TEST keys for development, LIVE keys for production
PAYSTACK_SECRET_KEY=sk_test_your_test_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_test_public_key

# Auth0 Configuration (Machine-to-Machine Authentication)
# Setup M2M application at: https://manage.auth0.com/dashboard
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=your_m2m_client_id
AUTH0_CLIENT_SECRET=your_m2m_client_secret
AUTH0_AUDIENCE=https://your-api-identifier

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_AUTH=100
RATE_LIMIT_PUBLIC=20

# Instructor Revenue Share (%)
INSTRUCTOR_REVENUE_SHARE=70

# Certificate Completion Threshold (%)
CERTIFICATE_THRESHOLD=80

# Swagger Docs Password (basic auth for prod)
SWAGGER_USER=admin
SWAGGER_PASS=changeme

# =============================================
# SECURITY BEST PRACTICES
# =============================================
# 
# 1. NEVER COMMIT .env FILE TO GIT
#    - Only commit .env.example
#    - Use .gitignore: echo ".env" >> .gitignore
#
# 2. GENERATE STRONG KEYS
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 3. USE CREDENTIAL SERVICE FOR SENSITIVE DATA
#    Path: src/utils/credential.service.js
#    
#    Hash a credential:
#    const CredentialService = require('./src/utils/credential.service');
#    const hash = await CredentialService.hashCredential(secretValue);
#    
#    Verify a credential:
#    const isValid = await CredentialService.verifyCredential(plaintext, hash);
#    
#    Generate random credential:
#    const randomKey = CredentialService.generateRandomCredential(32);
#
# 4. PRODUCTION SECRET MANAGEMENT
#    Use environment-specific tools:
#    - AWS Secrets Manager
#    - HashiCorp Vault
#    - Azure Key Vault
#    - Kubernetes Secrets
#    - GitHub Secrets (CI/CD)
#
# 5. KEY ROTATION SCHEDULE
#    - API Keys: Every 90 days
#    - JWT Secrets: Every 6 months
#    - Database Passwords: Every 90 days
#    - OAuth Secrets: Every 180 days
#
# =============================================
